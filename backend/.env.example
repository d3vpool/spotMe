# Backend environment variables — copy to .env and fill in.
# Validated at startup by src/config/env.ts (Zod) — the server refuses to
# boot with missing/invalid values, and refuses placeholder secrets in
# production (NODE_ENV=production). See DEPLOY.md for deploy-time values.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/spotme

# JWT signing secret — must be at least 32 characters (required).
# Generate one with: openssl rand -hex 32
# In production, placeholder-looking values are rejected at startup.
JWT_SECRET=replace-with-a-long-random-string

# Server port (optional, defaults to 3000)
PORT=3000

# Frontend origin for CORS (optional, defaults to http://localhost:5173).
# In production the SPA is served from this same origin — set it to the
# app's own public URL (e.g. https://your-app.fly.dev).
FRONTEND_URL=http://localhost:5173

# Node environment (optional). "production" enables serving the built SPA
# from Express and the placeholder-secret startup check.
NODE_ENV=development

# Google Drive API key — required at startup; only used by the Drive folder
# import feature (read-only, API-key only, no OAuth).
# Get one from Google Cloud Console: https://console.cloud.google.com/
#   1. Create or select a project
#   2. Enable the "Google Drive API"
#   3. Create an API key (restrict it to the Drive API only)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key

# Redis URL (required for background job processing via BullMQ)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Read only by scripts (NOT validated by the server at startup)
# ---------------------------------------------------------------------------

# Base URL stored in image rows created by `npm run seed:demo` — set this to
# the app's public URL when seeding a deployed instance.
# PUBLIC_URL=http://localhost:3000

# Password for the demo account created by `npm run seed:demo`
# (otherwise a random one is generated and printed once).
# DEMO_PASSWORD=
