[TEMPLATE]
# Backend environment variables — copy to .env and fill in.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/spotme

# JWT signing secret — must be at least 32 characters (required)
JWT_SECRET=replace-with-a-long-random-string

# Server port (optional, defaults to 3000)
PORT=3000

# Frontend origin for CORS (optional, defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Node environment (optional)
NODE_ENV=development

# Google Drive API key — required for the Drive folder import feature.
# Get one from Google Cloud Console: https://console.cloud.google.com/
# 1. Create or select a project
# 2. Enable the "Google Drive API"
# 3. Create an API key (restrict it to Drive API only)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key

# Redis URL (required for background job processing via BullMQ)
REDIS_URL=redis://localhost:6379
