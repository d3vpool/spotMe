# Frontend environment — copy to .env and adjust if your backend runs elsewhere.

# Base URL of the backend API. Must match the backend's PORT
# (backend/.env.example defaults to 3000).
# Leave EMPTY for production builds — the SPA is then served by the backend
# itself and calls the API same-origin (no CORS involved).
VITE_API_URL=http://localhost:3000

# Use the mock API layer instead of the real backend (development only).
VITE_USE_MOCKS=false
